---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ReadingModeToggle from './ReadingModeToggle.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { key: 'nav.about',        path: '/about' },
  { key: 'nav.research',     path: '/research' },
  { key: 'nav.publications', path: '/publications' },
  { key: 'nav.projects',     path: '/projects' },
  { key: 'nav.experience',   path: '/experience' },
  { key: 'nav.photography',  path: '/photography' },
  // Blog hidden until there is published content — restore when posts exist.
  // { key: 'nav.blog',         path: '/blog' },
  { key: 'nav.contact',      path: '/contact' },
] as const;

function isActive(path: string) {
  const bare = Astro.url.pathname.replace(/^\/(fr|ar)/, '') || '/';
  return bare === path || (path !== '/' && bare.startsWith(path));
}
---

<header class="site-header sticky top-0 z-50">
  <nav id="main-nav" class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3" aria-label="Main navigation">

    <a href={localizePath('/', lang)} class="wordmark font-serif text-xl font-semibold">
      Ismail El Jamiy
    </a>

    <ul class="hidden lg:flex items-center gap-5 font-sans text-sm">
      {navLinks.map(({ key, path }) => (
        <li>
          <a
            href={localizePath(path, lang)}
            class="nav-link"
            aria-current={isActive(path) ? 'page' : undefined}
          >
            {t(key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <ReadingModeToggle />
      <LanguageSwitcher />

      <button
        id="mobile-menu-btn"
        class="nav-link lg:hidden p-1"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t lg:hidden" style="border-color: var(--border)">
    <ul class="flex flex-col px-6 py-3 gap-3 font-sans text-sm">
      {navLinks.map(({ key, path }) => (
        <li>
          <a
            href={localizePath(path, lang)}
            class="nav-link block"
            aria-current={isActive(path) ? 'page' : undefined}
          >
            {t(key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  const header = document.querySelector('.site-header') as HTMLElement;
  // Transparent-over-hero only on pages that have a full-bleed dark hero
  const hasDarkHero = !!document.querySelector('#hero');

  function updateNav() {
    const scrolled = window.scrollY > 60;
    header.classList.toggle('scrolled', scrolled);
    // at-top = transparent state, only over the dark hero on the home page
    if (hasDarkHero) {
      header.classList.toggle('at-top', !scrolled);
    }
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();
</script>

<style>
  /* ── At top: transparent — overlays the dark hero ── */
  :global(header.site-header.at-top) {
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
  :global(header.site-header.at-top) .wordmark {
    color: #F6F1E4 !important;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }
  :global(header.site-header.at-top) .nav-link {
    color: rgba(246, 241, 228, 0.95) !important;
    text-shadow: 0 1px 8px rgba(0,0,0,0.7);
  }
  :global(header.site-header.at-top) .nav-link:hover,
  :global(header.site-header.at-top) .nav-link[aria-current="page"] {
    color: #F6F1E4 !important;
    border-bottom-color: rgba(246,241,228,0.6) !important;
  }
  /* Icons in at-top state */
  :global(header.site-header.at-top) button,
  :global(header.site-header.at-top) a.nav-link {
    filter: drop-shadow(0 1px 4px rgba(0,0,0,0.5));
  }

  /* ── Scrolled: floating pill nav ─────────────────── */
  :global(header.site-header.scrolled) {
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none !important;
    box-shadow: none !important;
  }
  :global(header.site-header.scrolled) #main-nav {
    max-width: 1000px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.07), 0 1px 4px rgba(0,0,0,0.04);
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    margin: 0.5rem auto;
  }

  /* Smooth transition for both states */
  :global(header.site-header) {
    transition: background-color 0.35s ease, border-color 0.35s ease;
  }
  :global(header.site-header) #main-nav {
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>
