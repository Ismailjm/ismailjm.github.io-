---
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
  {
    institution: "University of Toulouse (IRIT, IMT, CLLE)",
    degree: "PhD in Artificial Intelligence",
    period: "Nov. 2025 – Nov. 2028",
    location: "Toulouse, France",
    note: "Topic: Handwritten Text Recognition of medieval Arabic scientific manuscripts and development of dedicated LLM.",
  },
  {
    institution: "École Nationale Supérieure d'Arts et Métiers",
    degree: "State Engineer's Degree — AI & Computer Science Engineering",
    period: "Sep. 2022 – Sep. 2025",
    location: "Casablanca, Morocco",
    note: "Selective access based on average. Graduated with Highest Distinction.",
  },
  {
    institution: "Euclid High School",
    degree: "Baccalaureate in Mathematical Sciences (French option)",
    period: "Sep. 2019 – Jul. 2020",
    location: "Mohammedia, Morocco",
    note: "Highest Distinction.",
  },
];

const experience = [
  {
    role: "Research Intern — AI & Medical Imaging",
    org: "Institut de Recherche en Informatique de Toulouse (IRIT)",
    period: "Mar. 2025 – Sep. 2025",
    location: "Toulouse, France",
    objective: "Medical image segmentation using few-shot learning techniques.",
    bullets: [
      "Conducted a state-of-the-art review of segmentation algorithms with limited data and few-shot learning.",
      "Processed MRI and CT images, understanding their specificity and formats.",
      "Developed a segmentation model based on the U-Net architecture in a few-shot learning configuration.",
    ],
  },
  {
    role: "Volunteer Computer Vision Developer",
    org: "Youth For Challenge Association",
    period: "Aug. 2024 – Dec. 2024",
    location: "Casablanca, Morocco",
    objective: "Intelligent platform for real-time sign-language to text translation.",
    bullets: [
      "Conducted a state-of-the-art review of hand detection and segmentation methods.",
      "Developed a CNN-based algorithm for hand gesture recognition.",
      "Created an interface and deployed developed algorithms using Flask and OpenCV.",
    ],
  },
  {
    role: "Computer Vision Intern",
    org: "SYGMA.AI (InsurTech Company)",
    period: "Apr. 2024 – Jun. 2024",
    location: "Casablanca, Morocco",
    objective: "Intelligent solution for segmentation of damaged vehicle areas.",
    bullets: [
      "Collected and processed car images using Python, Selenium, and Scrapy.",
      "Implemented a CNN for classification of damaged vehicles using PyTorch.",
      "Developed a licence plate verification algorithm combining CNNs and OCR.",
    ],
  },
  {
    role: "AI & Image Processing Intern",
    org: "Lesieur Cristal",
    period: "Jul. 2023",
    location: "Casablanca, Morocco",
    objective: "PPE detection from video to minimise operational risks in industrial environments.",
    bullets: [
      "Built a structured dataset containing various PPE classes from diverse sources.",
      "Designed a PPE detection and recognition algorithm based on CNNs.",
    ],
  },
];

const skills: Record<string, string[]> = {
  "Data Science": ["Python", "Pandas", "NumPy", "Matplotlib", "Seaborn", "Plotly", "Selenium", "Scrapy"],
  "AI / ML Tools": ["Scikit-learn", "Keras", "TensorFlow", "PyTorch", "MONAI", "SimpleITK", "OpenCV", "HF Transformers", "spaCy", "NLTK", "pyarabic"],
  "Architectures": ["CNN", "U-Net", "RNN", "LSTM", "Transformers", "ViT", "VLM"],
  "Languages": ["Python", "JavaScript", "SQL", "Bash"],
};

const techIcons: Record<string, string> = {
  "Python":"python","Pandas":"pandas","NumPy":"numpy","Matplotlib":"matplotlib","Plotly":"plotly",
  "Selenium":"selenium","Scikit-learn":"scikitlearn","Keras":"keras","TensorFlow":"tensorflow",
  "PyTorch":"pytorch","OpenCV":"opencv","HF Transformers":"huggingface","JavaScript":"javascript",
  "Bash":"gnubash","SQL":"sqlite",
};

const certs = [
  { name: "Data Scientist Associate (90h)", issuer: "DataCamp", date: "Nov. 2024" },
  { name: "Advanced Learning Algorithms (34h)", issuer: "DeepLearning.AI", date: "Apr. 2023" },
  { name: "Supervised Machine Learning: Regression & Classification (33h)", issuer: "DeepLearning.AI", date: "Mar. 2023" },
  { name: "Machine Learning for Time Series Data in Python (4h)", issuer: "DataCamp", date: "Nov. 2024" },
];
---

<BaseLayout title="Experience" description="Ismail El Jamiy's education, work experience, and technical skills.">

  <!-- ── Page hero ─────────────────────────────────── -->
  <section class="page-hero">
    <div class="ph-ambient" aria-hidden="true"></div>
    <div class="ph-inner">
      <div class="ph-split">
        <div>
          <span class="ph-eyebrow">CV &amp; Background</span>
          <h1 class="ph-title">Experience</h1>
          <p class="ph-sub">
            From Casablanca to Toulouse — a journey through AI engineering,
            computer vision research, and manuscript digitisation.
          </p>
        </div>
        <div class="cv-btn-wrap">
          <a href="/Resume.pdf" target="_blank" rel="noopener" class="cv-dl-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Page body ──────────────────────────────────── -->
  <div class="page-body">

    <!-- Education -->
    <section class="cv-section">
      <div class="cv-section-header reveal">
        <span class="section-label">Formation</span>
        <h2 class="section-h2">Education</h2>
      </div>

      <div class="timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        {education.map((item, i) => (
          <div class="timeline-item reveal" data-delay={String(i * 0.12)}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-card">
              <div class="tl-period">{item.period}</div>
              <h3 class="tl-role">{item.degree}</h3>
              <div class="tl-org">{item.institution}</div>
              <div class="tl-loc">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {item.location}
              </div>
              {item.note && <p class="tl-note">{item.note}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Work Experience -->
    <section class="cv-section">
      <div class="cv-section-header reveal">
        <span class="section-label">Industry</span>
        <h2 class="section-h2">Work experience</h2>
      </div>

      <div class="timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        {experience.map((item, i) => (
          <div class="timeline-item reveal" data-delay={String(i * 0.1)}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-card">
              <div class="tl-period">{item.period}</div>
              <h3 class="tl-role">{item.role}</h3>
              <div class="tl-org">{item.org}</div>
              <div class="tl-loc">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {item.location}
              </div>
              <p class="tl-objective">{item.objective}</p>
              <ul class="tl-bullets">
                {item.bullets.map(b => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Skills -->
    <section class="cv-section">
      <div class="cv-section-header reveal">
        <span class="section-label">Technical</span>
        <h2 class="section-h2">Skills</h2>
      </div>
      <div class="skills-grid reveal">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skill-group">
            <h3 class="skill-category">{category}</h3>
            <div class="skill-tags">
              {items.map(tag => {
                const icon = techIcons[tag];
                return (
                  <span class={`skill-tag${icon ? ' has-icon' : ''}`}>
                    {icon && (
                      <img src={`https://cdn.simpleicons.org/${icon}`} width="12" height="12"
                           alt="" aria-hidden="true" class="skill-icon"
                           onerror="this.closest('.has-icon')?.classList.remove('has-icon'); this.remove()" />
                    )}
                    {tag}
                  </span>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section class="cv-section">
      <div class="cv-section-header reveal">
        <span class="section-label">Credentials</span>
        <h2 class="section-h2">Certifications</h2>
      </div>
      <div class="cert-grid">
        {certs.map((c, i) => (
          <div class="cert-card reveal" data-delay={String(i * 0.08)}>
            <div class="cert-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
            </div>
            <div class="cert-body">
              <span class="cert-name">{c.name}</span>
              <span class="cert-meta">{c.issuer} · {c.date}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

</BaseLayout>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { inView } from 'motion';

  gsap.registerPlugin(ScrollTrigger);
  const lenis = new Lenis({ duration: 1.2, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  gsap.from('.ph-inner > *', { y: 20, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out', delay: 0.1 });

  inView('.reveal', (element) => {
    const el = element as HTMLElement;
    const delay = parseFloat(el.dataset?.delay ?? '0');
    gsap.from(el, { y: 28, opacity: 0, duration: 0.65, delay, ease: 'power2.out', clearProps: 'all' });
  }, { amount: 0.12 });

  // Animate timeline line on scroll
  inView('.timeline-line', (element) => {
    const el = element as HTMLElement;
    gsap.from(el, { scaleY: 0, duration: 1.2, ease: 'power2.out', transformOrigin: 'top' });
  }, { amount: 0.1 });
</script>

<style>
  /* ── Hero extras ─────────────────────────────────── */
  .cv-btn-wrap { display: flex; align-items: flex-end; padding-top: 1rem; }
  .cv-dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    background: linear-gradient(160deg, var(--color-olive), color-mix(in srgb, var(--color-olive) 78%, black));
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-olive) 22%, transparent);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cv-dl-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 18px color-mix(in srgb, var(--color-olive) 28%, transparent); }
  [data-theme="dark"] .cv-dl-btn { background: linear-gradient(160deg, var(--color-gold), color-mix(in srgb, var(--color-gold) 78%, black)); color: var(--color-night); }

  /* ── CV sections ─────────────────────────────────── */
  .cv-section { margin-bottom: 4.5rem; }
  .cv-section-header { margin-bottom: 2rem; }

  /* ── Vertical timeline ───────────────────────────── */
  .timeline {
    position: relative;
    padding-left: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-line {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-olive), color-mix(in srgb, var(--color-olive) 20%, transparent));
    border-radius: 1px;
    transform-origin: top;
  }
  [data-theme="dark"] .timeline-line {
    background: linear-gradient(to bottom, var(--color-gold), color-mix(in srgb, var(--color-gold) 15%, transparent));
  }

  .timeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .timeline-dot {
    position: absolute;
    left: -2.5rem;
    top: 1.1rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--color-olive);
    background: var(--bg);
    z-index: 1;
    transform: translateX(0);
    transition: background 0.2s, transform 0.2s;
  }
  [data-theme="dark"] .timeline-dot { border-color: var(--color-gold); }
  .timeline-item:hover .timeline-dot {
    background: var(--color-olive);
    transform: scale(1.25);
  }
  [data-theme="dark"] .timeline-item:hover .timeline-dot { background: var(--color-gold); }

  .timeline-card {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .timeline-item:hover .timeline-card {
    border-color: var(--accent);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 12%, transparent);
    transform: translateX(4px);
  }

  .tl-period {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-terracotta);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .tl-role {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .tl-org {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  [data-theme="dark"] .tl-org { color: var(--color-gold); }

  .tl-loc {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .tl-note, .tl-objective {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--fg-muted);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  .tl-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tl-bullets li {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .tl-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-olive);
    font-weight: 600;
    font-size: 0.75rem;
  }
  [data-theme="dark"] .tl-bullets li::before { color: var(--color-gold); }

  /* ── Skills ──────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .skill-group {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
  }

  .skill-category {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin: 0 0 0.875rem;
  }

  .skill-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.55rem;
    transition: border-color 0.15s, color 0.15s;
  }
  .skill-tag:hover { border-color: var(--color-olive); color: var(--color-olive); }
  .skill-icon { width: 12px; height: 12px; object-fit: contain; }

  /* ── Certifications ──────────────────────────────── */
  .cert-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .cert-card:hover { border-color: var(--color-olive); transform: translateY(-2px); }

  .cert-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-gold) 10%, transparent);
    border-radius: 6px;
    color: var(--color-gold);
    margin-top: 2px;
  }

  .cert-body { display: flex; flex-direction: column; gap: 0.25rem; }
  .cert-name { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--fg); line-height: 1.4; }
  .cert-meta { font-family: var(--font-sans); font-size: 0.75rem; color: var(--fg-muted); }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 800px) {
    .ph-split { grid-template-columns: 1fr; }
    .cv-btn-wrap { padding-top: 0; }
    .skills-grid { grid-template-columns: 1fr; }
    .cert-grid { grid-template-columns: 1fr; }
  }
</style>
