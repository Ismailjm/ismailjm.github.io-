---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { label: "Email", value: "eljamiy.ismail@gmail.com", href: "mailto:eljamiy.ismail@gmail.com", accent: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>` },
  { label: "GitHub", value: "@Ismailjm", href: "https://github.com/Ismailjm", accent: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>` },
  { label: "LinkedIn", value: "Ismail EL JAMIY", href: "https://linkedin.com/in/ismail-el-jamiy", accent: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
  { label: "Google Scholar", value: "Ismail El Jamiy", href: "https://scholar.google.com/citations?user=QDB_Lh4AAAAJ&hl=en", accent: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 10a8 8 0 0 1 7.162 3.44L24 9.5z"/></svg>` },
  { label: "ORCID", value: "0009-0004-0166-1115", href: "https://orcid.org/0009-0004-0166-1115", accent: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zM86.3 186.2H65.1V107.5h21.2v78.7zm-10.6-90c-6.8 0-11.1-4.7-11.1-10.5 0-6 4.5-10.5 11.3-10.5 6.8 0 11 4.5 11 10.5 0 6-4.2 10.5-11.2 10.5zm100.7 90h-21.2v-44c0-10.6-.4-24.3-14.8-24.3-14.8 0-17.1 11.6-17.1 23.6v44.7H102v-78.7h20.3v10.7h.3c2.8-5.3 9.7-10.9 20-10.9 21.4 0 25.4 14.1 25.4 32.4v46.5z"/></svg>` },
];
---

<BaseLayout title="Contact" description="Get in touch with Ismail El Jamiy.">

  <!-- ── Page hero ─────────────────────────────────── -->
  <section class="page-hero">
    <div class="ph-ambient" aria-hidden="true"></div>
    <div class="ph-inner">
      <span class="ph-eyebrow">Get in touch</span>
      <h1 class="ph-title">Contact</h1>
      <p class="ph-sub">
        Open to collaborations with researchers, engineers, and anyone working on
        Arabic heritage, HTR, or computer vision.
      </p>
    </div>
  </section>

  <!-- ── Page body ──────────────────────────────────── -->
  <div class="page-body contact-body">

    <!-- Invite -->
    <div class="contact-invite reveal">
      <div class="invite-text">
        <p>
          I'm happy to hear from researchers, collaborators, and anyone with an interest in
          Arabic heritage, HTR, or computer vision. The best way to reach me is by email — I
          respond to all serious enquiries.
        </p>
        <div class="invite-loc">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Toulouse, France · UTC+1
        </div>
      </div>
      <div class="invite-calli" aria-hidden="true">
        <span lang="ar" dir="rtl">تواصل معي</span>
      </div>
    </div>

    <!-- Contact links -->
    <div class="links-grid">
      {links.map((link, i) => (
        <a href={link.href}
           target={link.href.startsWith('mailto') ? undefined : '_blank'}
           rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
           class={`contact-card reveal${link.accent ? ' contact-card-accent' : ''}`}
           data-delay={String(i * 0.07)}>
          <span class="cc-icon" set:html={link.icon} />
          <div class="cc-text">
            <span class="cc-label">{link.label}</span>
            <span class="cc-value">{link.value}</span>
          </div>
          <span class="cc-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { inView } from 'motion';

  gsap.registerPlugin(ScrollTrigger);
  const lenis = new Lenis({ duration: 1.2, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  gsap.from('.ph-inner > *', { y: 20, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out', delay: 0.1 });

  inView('.reveal', (element) => {
    const el = element as HTMLElement;
    const delay = parseFloat(el.dataset?.delay ?? '0');
    gsap.from(el, { y: 24, opacity: 0, duration: 0.6, delay, ease: 'power2.out', clearProps: 'all' });
  }, { amount: 0.15 });
</script>

<style>
  /* ── Layout ─────────────────────────────────────── */
  .contact-body { max-width: 860px !important; }

  /* ── Invite block ────────────────────────────────── */
  .contact-invite {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .invite-text {
    flex: 1;
  }

  .invite-text p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }

  .invite-loc {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .invite-calli {
    font-family: var(--font-arabic);
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-gold);
    opacity: 0.5;
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.5rem;
    text-shadow: 0 2px 12px color-mix(in srgb, var(--color-gold) 20%, transparent);
  }

  /* ── Contact cards grid ──────────────────────────── */
  .links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .contact-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .contact-card-accent {
    border-color: color-mix(in srgb, var(--color-olive) 35%, transparent);
    background: color-mix(in srgb, var(--color-olive) 4%, var(--bg-panel));
  }
  .contact-card-accent .cc-label { color: var(--color-olive); }
  [data-theme="dark"] .contact-card-accent {
    border-color: color-mix(in srgb, var(--color-gold) 28%, transparent);
    background: color-mix(in srgb, var(--color-gold) 4%, var(--bg-panel));
  }
  [data-theme="dark"] .contact-card-accent .cc-label { color: var(--color-gold); }

  .cc-icon {
    color: var(--accent);
    flex-shrink: 0;
    display: flex;
    width: 20px;
    height: 20px;
  }

  .cc-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .cc-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .cc-value {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cc-arrow {
    color: var(--fg-muted);
    opacity: 0;
    flex-shrink: 0;
    transition: opacity 0.2s, transform 0.2s;
    display: flex;
  }
  .contact-card:hover .cc-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translateX(3px);
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 700px) {
    .contact-invite { flex-direction: column; gap: 1.5rem; }
    .invite-calli { font-size: 2.5rem; }
    .links-grid { grid-template-columns: 1fr; }
  }
</style>
