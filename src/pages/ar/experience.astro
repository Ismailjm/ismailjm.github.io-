// Icon sources. si() = Simple Icons CDN (brand marks); the rest are served from
// public/icons/ — brand/ holds third-party logos Simple Icons does not carry, and
// skills/ holds the olive line glyphs drawn for tools and concepts that have no logo.
const si = (slug: string) => `https://cdn.simpleicons.org/${slug}`;
const glyph = (name: string) => `/icons/skills/${name}.svg`;

const techIcons: Record<string, string> = {
  // Programming & environment
  "Python": si("python"), "JavaScript": si("javascript"), "SQL": si("sqlite"),
  "Bash": si("gnubash"), "LaTeX": si("latex"), "Git": si("git"), "Linux": si("linux"),
  "HPC (Jean Zay, SLURM)": glyph("server"),
  // Data & visualisation
  "Pandas": si("pandas"), "NumPy": si("numpy"), "Matplotlib": "/icons/brand/matplotlib.svg",
  "Seaborn": glyph("chart-dist"), "Plotly": si("plotly"), "Selenium": si("selenium"),
  "Scrapy": si("scrapy"),
