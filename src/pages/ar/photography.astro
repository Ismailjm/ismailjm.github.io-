---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { photos, photoImages } from '../../data/photos';

const ui = { photo: 'صورة', photos: 'صورة', from: 'من', clear: 'إزالة التصفية' };
const globeHint = 'اسحب للاستكشاف · انقر على علامة للتصفية';
const titleNames: Record<string, string> = {
  'Tour Eiffel': 'برج إيفل',
  'Building': 'مبنى',
  'Basilique Saint-Sernin': 'كنيسة سان سيرنان',
  'Chapelle Saint-Joseph de la Grave': 'كنيسة سان جوزيف دو لا غراف',
  'Musée des Augustins': 'متحف الأوغسطينيين',
  'Cathédrale Notre-Dame': 'كاتدرائية نوتردام',
  'Sculpture': 'منحوتة',
  'Beach': 'شاطئ',
  'Collioure': 'كوليور',
  'Mosquée Hassan II': 'مسجد الحسن الثاني',
  'Casablanca from the Air': 'الدار البيضاء من الجو',
  'Mohammed VI Tower': 'برج محمد السادس',
  'Porsche Museum': 'متحف بورشه',
  'Fernsehturm Stuttgart': 'برج تلفزيون شتوتغارت',
};
const placeNames: Record<string, string> = {
  'Paris': 'باريس',
  'Toulouse': 'تولوز',
  'Strasbourg': 'ستراسبورغ',
  'Marseille': 'مارسيليا',
  'Leucate': 'لوكات',
  'Collioure': 'كوليور',
  'Casablanca': 'الدار البيضاء',
  'Salé': 'سلا',
  'Stuttgart': 'شتوتغارت',
};
const countryNames: Record<string, string> = {
  'France': 'فرنسا',
  'Morocco': 'المغرب',
  'Germany': 'ألمانيا',
};

const items = photos.map((p) => ({
  file: p.file,
  title: titleNames[p.title] ?? p.title,
  place: placeNames[p.place] ?? p.place,
  placeKey: p.place,
  country: countryNames[p.country] ?? p.country,
  lat: p.lat,
  lng: p.lng,
}));

// Unique locations for globe markers
const locations = Object.values(
  items.reduce<Record<string, { place: string; placeKey: string; country: string; lat: number; lng: number; count: number }>>(
    (acc, p) => {
      if (!acc[p.placeKey]) {
        acc[p.placeKey] = { place: p.place, placeKey: p.placeKey, country: p.country, lat: p.lat, lng: p.lng, count: 0 };
      }
      acc[p.placeKey].count++;
      return acc;
    },
    {}
  )
);

// Pick one photo per location for polaroid cards
const polaroids = locations.map((loc) => {
  const photo = items.find((p) => p.placeKey === loc.placeKey)!;
  return { ...loc, file: photo.file, title: photo.title };
});
---

<BaseLayout title="التصوير" description="صور اسماعيل الجامعي — العمارة والأسفار في فرنسا والمغرب وألمانيا.">
  <div class="page-container">

    <header class="page-header">
      <h1 class="page-title">التصوير</h1>
      <div class="page-rule" aria-hidden="true"></div>
      <p class="page-subtitle">لحظات التُقطت في فرنسا والمغرب وألمانيا.</p>
    </header>

    <section class="globe-section" aria-label="مواقع الصور">
      <div class="globe-wrap">

        <div class="polaroids-left" id="polaroids-left" aria-hidden="true">
          {polaroids.slice(0, 4).map((p) => (
            <button class="polaroid" data-place={p.placeKey} type="button" aria-label={`تصفية حسب ${p.place}`}>
              <div class="polaroid-img">
                <Image src={photoImages[p.file]} alt={p.title} width={120} height={90} loading="lazy" />
              </div>
              <span class="polaroid-label">{p.place}</span>
              <span class="polaroid-country">{p.country}</span>
            </button>
          ))}
        </div>

        <div class="globe-container">
          <canvas id="globe-canvas" width="520" height="520"></canvas>
          <div class="globe-hint" id="globe-hint">{globeHint}</div>
        </div>

        <div class="polaroids-right" id="polaroids-right" aria-hidden="true">
          {polaroids.slice(4, 8).map((p) => (
            <button class="polaroid" data-place={p.placeKey} type="button" aria-label={`تصفية حسب ${p.place}`}>
              <div class="polaroid-img">
                <Image src={photoImages[p.file]} alt={p.title} width={120} height={90} loading="lazy" />
              </div>
              <span class="polaroid-label">{p.place}</span>
              <span class="polaroid-country">{p.country}</span>
            </button>
          ))}
        </div>

      </div>

      <div id="filter-bar" class="filter-bar" hidden>
        <span id="filter-text"></span>
        <button id="clear-filter" type="button">{ui.clear}</button>
      </div>
    </section>

    <div id="globe-data"
      data-items={JSON.stringify(items)}
      data-locations={JSON.stringify(locations)}
      data-ui={JSON.stringify(ui)}
      hidden>
    </div>

    <div class="masonry" id="photo-grid">
      {items.map((p) => (
        <div class="masonry-item" data-place={p.placeKey}>
          <div class="photo-card">
            <Image
              src={photoImages[p.file]}
              alt={`${p.title} — ${p.place}، ${p.country}`}
              widths={[280, 560, 840]}
              sizes="(max-width: 600px) 90vw, (max-width: 1100px) 45vw, 340px"
              loading="lazy"
              decoding="async"
            />
            <div class="photo-overlay" aria-hidden="true">
              <p class="photo-title">{p.title}</p>
              <p class="photo-place">{p.place}، {p.country}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  import createGlobe from 'cobe';

  // ── Read server-side data from DOM ───────────────────
  const dataEl = document.getElementById('globe-data') as HTMLElement;
  const locations: { place: string; placeKey: string; country: string; lat: number; lng: number; count: number }[] = JSON.parse(dataEl.dataset.locations!);
  const ui: { photo: string; photos: string; from: string; clear: string } = JSON.parse(dataEl.dataset.ui!);

  // ── Cobe Globe ──────────────────────────────────────

  const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement;
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

  // Convert lat/lng to cobe marker format (place field stripped — not a cobe property)
  const markers = locations.map(loc => ({
    location: [loc.lat, loc.lng] as [number, number],
    size: Math.min(0.06 + loc.count * 0.012, 0.1),
  }));

  let phi = 0.5;
  let dragging = false;
  let lastX = 0;
  let activePlace: string | null = null;

  const globe = createGlobe(canvas, {
    devicePixelRatio: Math.min(window.devicePixelRatio, 2),
    width:  520,
    height: 520,
    phi,
    theta: 0.28,
    dark:         isDark ? 1 : 0,
    diffuse:      1.4,
    mapSamples:   20000,
    mapBrightness: isDark ? 4 : 7,
    baseColor:    isDark ? [0.08, 0.07, 0.05] : [0.96, 0.93, 0.89],
    markerColor:  [0.34, 0.42, 0.18],
    glowColor:    isDark ? [0.08, 0.07, 0.05] : [0.96, 0.93, 0.89],
    opacity:      0.85,
    markers,
  });

  // cobe v2 uses globe.update() in an animation loop instead of onRender callback
  function tick() {
    if (!dragging) phi += 0.003;
    globe.update({ phi, theta: 0.28 });
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  // ── Drag to rotate ────────────────────────────────
  canvas.addEventListener('mousedown', (e) => {
    dragging = true;
    lastX = e.clientX;
    (document.getElementById('globe-hint') as HTMLElement).style.opacity = '0';
  });
  window.addEventListener('mousemove', (e) => {
    if (!dragging) return;
    phi += (e.clientX - lastX) * 0.005;
    lastX = e.clientX;
  });
  window.addEventListener('mouseup', () => { dragging = false; });

  canvas.addEventListener('touchstart', (e) => {
    dragging = true;
    lastX = e.touches[0].clientX;
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!dragging) return;
    phi += (e.touches[0].clientX - lastX) * 0.005;
    lastX = e.touches[0].clientX;
  }, { passive: true });
  window.addEventListener('touchend', () => { dragging = false; });

  // ── Filter logic ──────────────────────────────────
  function setFilter(placeKey: string, placeLabel: string) {
    activePlace = placeKey;
    let count = 0;
    document.querySelectorAll<HTMLElement>('.masonry-item').forEach((item) => {
      if (item.dataset.place === placeKey) { item.style.display = ''; count++; }
      else { item.style.display = 'none'; }
    });
    document.querySelectorAll<HTMLElement>('.polaroid').forEach(p => {
      p.classList.toggle('polaroid-active', p.dataset.place === placeKey);
    });
    const bar = document.getElementById('filter-bar') as HTMLElement;
    const text = document.getElementById('filter-text') as HTMLElement;
    text.textContent = `${count} ${count !== 1 ? ui.photos : ui.photo} ${ui.from} ${placeLabel}`;
    bar.hidden = false;
  }

  function clearFilter() {
    activePlace = null;
    document.querySelectorAll<HTMLElement>('.masonry-item').forEach(i => { i.style.display = ''; });
    document.querySelectorAll('.polaroid').forEach(p => p.classList.remove('polaroid-active'));
    (document.getElementById('filter-bar') as HTMLElement).hidden = true;
  }

  (document.getElementById('clear-filter') as HTMLElement).addEventListener('click', clearFilter);

  // Polaroid buttons trigger filter
  document.querySelectorAll<HTMLElement>('.polaroid').forEach(btn => {
    btn.addEventListener('click', () => {
      const pk = btn.dataset.place!;
      if (activePlace === pk) { clearFilter(); return; }
      const loc = locations.find(l => l.placeKey === pk);
      if (loc) setFilter(pk, loc.place);
    });
  });

  // Adapt globe when theme changes
  const observer = new MutationObserver(() => {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    // cobe doesn't expose live update, so just re-create would be complex;
    // the theme transition is graceful enough as-is
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .page-header { margin-bottom: 2.5rem; }

  .page-title {
    font-family: var(--font-arabic);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 0.75rem;
  }

  .page-rule {
    height: 2px;
    background: linear-gradient(to left, var(--color-olive), transparent);
    border-radius: 1px;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    font-family: var(--font-arabic);
    font-size: 1rem;
    color: var(--fg-muted);
    margin: 0;
  }

  /* ── Globe section ───────────────────────────────── */
  .globe-section { margin-bottom: 2.5rem; }

  .globe-wrap {
    display: grid;
    grid-template-columns: 1fr 520px 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 420px;
  }

  /* ── Cobe canvas ─────────────────────────────────── */
  .globe-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  #globe-canvas {
    border-radius: 50%;
    cursor: grab;
    transition: opacity 0.3s;
  }
  #globe-canvas:active { cursor: grabbing; }

  .globe-hint {
    font-family: var(--font-arabic);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    text-align: center;
    transition: opacity 0.4s;
  }

  /* ── Polaroid cards ──────────────────────────────── */
  .polaroids-left,
  .polaroids-right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .polaroid {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem 0.5rem 0.75rem;
    cursor: pointer;
    width: 138px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1), 0 1px 4px rgba(0,0,0,0.06);
    transition: transform 0.3s cubic-bezier(0.25,1,.5,1),
                box-shadow 0.3s cubic-bezier(0.25,1,.5,1),
                border-color 0.2s;
    text-align: center;
  }
  .polaroids-left .polaroid:nth-child(odd)  { transform: rotate(-2deg); }
  .polaroids-left .polaroid:nth-child(even) { transform: rotate(1.5deg); }
  .polaroids-right .polaroid:nth-child(odd) { transform: rotate(1.8deg); }
  .polaroids-right .polaroid:nth-child(even){ transform: rotate(-1.2deg); }

  .polaroid:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.05) !important;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18), 0 4px 8px rgba(0,0,0,0.1);
    border-color: var(--color-olive);
    z-index: 10;
  }

  .polaroid-active {
    transform: rotate(0deg) translateY(-8px) scale(1.06) !important;
    box-shadow: 0 14px 36px color-mix(in srgb, var(--color-olive) 25%, transparent) !important;
    border-color: var(--color-olive) !important;
    z-index: 10;
  }

  .polaroid-img {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 0.5rem;
    background: var(--border);
  }
  .polaroid-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .polaroid:hover .polaroid-img img { transform: scale(1.08); }

  .polaroid-label {
    display: block;
    font-family: var(--font-arabic);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.3;
  }

  .polaroid-country {
    display: block;
    font-family: var(--font-arabic);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--fg-muted);
    margin-top: 0.1rem;
  }

  /* ── Filter bar ──────────────────────────────────── */
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-arabic);
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .filter-bar[hidden] { display: none; }

  #clear-filter {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.18rem 0.65rem;
    font-family: var(--font-arabic);
    font-size: 0.85rem;
    color: var(--fg-muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  #clear-filter:hover {
    border-color: var(--color-olive);
    color: var(--fg);
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 1000px) {
    .globe-wrap {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: auto;
    }
    .polaroids-left  { order: 2; flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .polaroids-right { order: 3; flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .globe-container { order: 1; }
    #globe-canvas { width: 320px; height: 320px; }
  }

  .masonry {
    columns: 3 260px;
    column-gap: 0.875rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.875rem;
  }

  .photo-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--bg-panel);
    cursor: zoom-in;
  }

  .photo-card img {
    width: 100%;
    display: block;
    transition: transform 0.45s ease;
  }

  .photo-card:hover img {
    transform: scale(1.05);
  }

  .photo-overlay {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 0.875rem 0.875rem;
    background: linear-gradient(to top, rgba(18, 12, 4, 0.8) 0%, transparent 100%);
    transform: translateY(100%);
    transition: transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .photo-card:hover .photo-overlay {
    transform: translateY(0);
  }

  .photo-title {
    font-family: var(--font-arabic);
    font-size: 1.05rem;
    font-weight: 700;
    color: #f5f0e8;
    margin: 0 0 0.2rem;
    line-height: 1.4;
  }

  .photo-place {
    font-family: var(--font-arabic);
    font-size: 0.8rem;
    color: rgba(245, 240, 232, 0.72);
    margin: 0;
  }
</style>
